# Copy to .env (gitignored). Never put real keys, customer names, or sample data here.
#
# Most of these are now **defaults the admin console can override** (ADR-023). The
# order is: a value set in the console, then the value here, then the built-in
# default. A setting nobody has touched in the console still comes from this file.
# The exceptions are DATABASE_URL, GREENLIGHT_AI_DATA_DIR, GREENLIGHT_AI_BIND_HOST and
# GREENLIGHT_AI_SECRET_KEY: each is needed to reach or protect the settings store itself,
# so none of them can live inside it.

# --- LLM adapter (docs/design.md "LLM adapter"; ADR-004) --------------------------
LLM_PROVIDER=mock                   # openai | anthropic | mock
LLM_BASE_URL=http://localhost:11434/v1   # Ollama's OpenAI-compatible endpoint on a Mac
LLM_API_KEY=changeme
LLM_MODEL=gemma3:27b
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120
LLM_MAX_CONCURRENCY=4               # calls in flight per worker
LLM_MAX_TOKENS_PER_RUN=400000       # a run that exceeds it stops and is flagged (ADR-005)
LLM_LOG_PROMPTS=false               # keep false whenever data may hold PII (ADR-003)
LLM_PII_TRIPWIRE=true               # scan every prompt and refuse to send a match; leave on
LLM_PROMPT_VERSION=1                # part of every cache key (ADR-005)

# Stage 8 reads each high-severity finding a second time. "single" is the one second
# opinion the tool has always asked for. Naming lenses -- delivery,compliance,requirements
# -- has each read the same evidence independently, never each other's answers, with code
# merging them (ADR-034). It stays "single" until the golden-set benchmark measures the
# three against it: what reviewers see changes only on evidence. Empty turns verification
# off, which the run reports as a notice.
LLM_VERIFY_LENSES=single
LLM_MAX_LENS_CALLS_PER_RUN=150      # a ceiling beside the token budget

# --- Database + queue (ADR-007, ADR-017) ---------------------------------------------
# One switch chooses the backend and nothing else changes. SQLite is the default and
# needs nothing installed; Postgres is what docker-compose configures, because SQLite
# takes one writer at a time.
DATABASE_URL=sqlite+pysqlite:///./data/greenlight-ai.db
# DATABASE_URL=postgresql+psycopg://greenlight_ai:greenlight_ai@localhost:5432/greenlight_ai
DB_ECHO=false                       # log every statement; off, statements carry names
DB_POOL_SIZE=5                      # ignored by SQLite

# Used only when DATABASE_URL points at the compose Postgres service.
POSTGRES_USER=greenlight_ai
POSTGRES_PASSWORD=greenlight_ai
POSTGRES_DB=greenlight_ai

# --- Files (shared Docker volume; ADR-007) ------------------------------------------
GREENLIGHT_AI_DATA_DIR=./data             # uploads, generated reports, PDFs
GREENLIGHT_AI_RETENTION_DAYS=90
GREENLIGHT_AI_MAX_UPLOAD_MB=50

# --- Secrets (ADR-023) ---------------------------------------------------------------
# Needed only if an administrator should be able to set the LLM API key from the
# console. Generate with: python -c "from cryptography.fernet import Fernet; \
# print(Fernet.generate_key().decode())"
# Back it up OUTSIDE the database: losing it loses every secret it protects, by design.
# Rotate by putting the new key first: GREENLIGHT_AI_SECRET_KEY=new,old
# GREENLIGHT_AI_SECRET_KEY=

# --- Throughput (ADR-023; all overridable in the admin console) ----------------------
GREENLIGHT_AI_MAX_CONCURRENT_RUNS=4       # runs in flight across all workers
GREENLIGHT_AI_STARTS_PER_WINDOW=20        # runs that may start per window
GREENLIGHT_AI_RATE_WINDOW_S=300           # the window, five minutes
GREENLIGHT_AI_MAX_QUEUE_WAIT_S=1800       # a longer wait is flagged, not cancelled
GREENLIGHT_AI_PER_ORDER_LIMIT=3           # queued runs per order number

# --- Training (ADR-021; all overridable in the admin console) ------------------------
GREENLIGHT_AI_TRAIN_AI_MODE=false          # lets reviewers record observations
GREENLIGHT_AI_TRAINING_SHADOW_DEFAULT=true # approvals start in shadow; leave on
GREENLIGHT_AI_TRAINING_REPLAY_RUNS=25      # finalized runs a candidate is replayed against

# --- Login (ADR-022) -----------------------------------------------------------------
# Both default to false: with them off there is no prompt, no cookie, and every action
# is attributed to the seeded placeholder account. Turn them on in production.
GREENLIGHT_AI_ADMIN_AUTH=false            # the admin console and /api/v1/admin/*
GREENLIGHT_AI_USER_AUTH=false             # the user app and the rest of the API
GREENLIGHT_AI_SESSION_TTL_S=28800         # absolute session lifetime: a working day
GREENLIGHT_AI_SESSION_IDLE_S=3600         # idle timeout
GREENLIGHT_AI_MIN_PASSWORD_LENGTH=12      # the only composition rule; no complexity, no expiry
GREENLIGHT_AI_LOCKOUT_THRESHOLD=5         # consecutive failures before a cooling-off period
GREENLIGHT_AI_LOCKOUT_S=900
# What the API binds to. Used for one check: with admin login on and the bootstrap
# password (admin/admin123) unchanged, a non-loopback deployment refuses to serve.
GREENLIGHT_AI_BIND_HOST=127.0.0.1

# --- API / UIs ----------------------------------------------------------------------
GREENLIGHT_AI_API_URL=http://127.0.0.1:8000      # user-ui and admin-ui proxy /api/* here
# The colour theme of both apps: default | light-blue-yellow | classic-teal | classic-teal-navy. Each has a
# light and a dark variant, switched in the sidebar. Read at request time, so a change
# here shows on the next page load with no rebuild. Set from the admin console later
# (docs/phase-6.6.md).
GREENLIGHT_AI_UI_THEME=classic-teal-navy
# Hide the theme picker in both apps and apply the default everywhere. Both of these
# can be overridden from the admin console's Appearance group (ADR-023).
GREENLIGHT_AI_UI_THEME_LOCKED=false
# Offer a Guide in each app's sidebar, written for whoever uses that app and built from
# the same source as their training document (docs/phase-6.19.md). On by default. Switch
# it off where training is delivered another way and a second copy inside the product
# would be one more thing to keep current; it changes nothing but whether the Guide is
# offered. Overridable from the admin console's Appearance group (ADR-023).
GREENLIGHT_AI_UI_GUIDE=true

# Ask the frozen report: a chat panel on a finalized run's report page, answering only
# about that run from a context pack code assembles on every turn (docs/phase-8.md,
# ADR-068). **Off unless set**, which is deliberate — an install that upgrades should
# never silently gain an outbound model surface, so turning it on is somebody's
# decision rather than a side effect. Overridable from the admin console's Chat group
# (ADR-023), where the caps live too: questions per run and per day, tokens, turns.
#
# The model is deliberately absent. Leave `chat.model` unset and the chat answers with
# LLM_MODEL above, so the two never drift apart and a change there carries. Set it in
# the console only to make the chat answer with something other than the pipeline's.
GREENLIGHT_AI_CHAT=false
USER_UI_PORT=3000
ADMIN_UI_PORT=3001
