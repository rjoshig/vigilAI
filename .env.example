# Copy to .env (gitignored). Never put real keys, customer names, or sample data here.
#
# Most of these are now **defaults the admin console can override** (ADR-023). The
# order is: a value set in the console, then the value here, then the built-in
# default. A setting nobody has touched in the console still comes from this file.
# The exceptions are DATABASE_URL, VIGILAI_DATA_DIR, VIGILAI_BIND_HOST and
# VIGILAI_SECRET_KEY: each is needed to reach or protect the settings store itself,
# so none of them can live inside it.

# --- LLM adapter (docs/design.md "LLM adapter"; ADR-004) --------------------------
LLM_PROVIDER=mock                   # openai | anthropic | mock
LLM_BASE_URL=http://localhost:11434/v1   # Ollama's OpenAI-compatible endpoint on a Mac
LLM_API_KEY=changeme
LLM_MODEL=gemma3:27b
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0
LLM_TIMEOUT_S=120
LLM_MAX_CONCURRENCY=4               # calls in flight per worker
LLM_MAX_TOKENS_PER_RUN=400000       # a run that exceeds it stops and is flagged (ADR-005)
LLM_LOG_PROMPTS=false               # keep false whenever data may hold PII (ADR-003)
LLM_PII_TRIPWIRE=true               # scan every prompt and refuse to send a match; leave on
LLM_PROMPT_VERSION=1                # part of every cache key (ADR-005)

# --- Database + queue (ADR-007, ADR-017) ---------------------------------------------
# One switch chooses the backend and nothing else changes. SQLite is the default and
# needs nothing installed; Postgres is what docker-compose configures, because SQLite
# takes one writer at a time.
DATABASE_URL=sqlite+pysqlite:///./data/vigilai.db
# DATABASE_URL=postgresql+psycopg://vigilai:vigilai@localhost:5432/vigilai
DB_ECHO=false                       # log every statement; off, statements carry names
DB_POOL_SIZE=5                      # ignored by SQLite

# Used only when DATABASE_URL points at the compose Postgres service.
POSTGRES_USER=vigilai
POSTGRES_PASSWORD=vigilai
POSTGRES_DB=vigilai

# --- Files (shared Docker volume; ADR-007) ------------------------------------------
VIGILAI_DATA_DIR=./data             # uploads, generated reports, PDFs
VIGILAI_RETENTION_DAYS=90
VIGILAI_MAX_UPLOAD_MB=50

# --- Secrets (ADR-023) ---------------------------------------------------------------
# Needed only if an administrator should be able to set the LLM API key from the
# console. Generate with: python -c "from cryptography.fernet import Fernet; \
# print(Fernet.generate_key().decode())"
# Back it up OUTSIDE the database: losing it loses every secret it protects, by design.
# Rotate by putting the new key first: VIGILAI_SECRET_KEY=new,old
# VIGILAI_SECRET_KEY=

# --- Throughput (ADR-023; all overridable in the admin console) ----------------------
VIGILAI_MAX_CONCURRENT_RUNS=4       # runs in flight across all workers
VIGILAI_STARTS_PER_WINDOW=20        # runs that may start per window
VIGILAI_RATE_WINDOW_S=300           # the window, five minutes
VIGILAI_MAX_QUEUE_WAIT_S=1800       # a longer wait is flagged, not cancelled
VIGILAI_PER_ORDER_LIMIT=3           # queued runs per order number

# --- Login (ADR-022) -----------------------------------------------------------------
# Both default to false: with them off there is no prompt, no cookie, and every action
# is attributed to the seeded placeholder account. Turn them on in production.
VIGILAI_ADMIN_AUTH=false            # the admin console and /api/v1/admin/*
VIGILAI_USER_AUTH=false             # the user app and the rest of the API
VIGILAI_SESSION_TTL_S=28800         # absolute session lifetime: a working day
VIGILAI_SESSION_IDLE_S=3600         # idle timeout
VIGILAI_MIN_PASSWORD_LENGTH=12      # the only composition rule; no complexity, no expiry
VIGILAI_LOCKOUT_THRESHOLD=5         # consecutive failures before a cooling-off period
VIGILAI_LOCKOUT_S=900
# What the API binds to. Used for one check: with admin login on and the bootstrap
# password (admin/admin123) unchanged, a non-loopback deployment refuses to serve.
VIGILAI_BIND_HOST=127.0.0.1

# --- API / UIs ----------------------------------------------------------------------
VIGILAI_API_URL=http://127.0.0.1:8000      # user-ui and admin-ui proxy /api/* here
VIGILAI_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# The colour theme of both apps: default | light-blue-yellow | classic-teal. Each has a
# light and a dark variant, switched in the sidebar. Read at request time, so a change
# here shows on the next page load with no rebuild. Set from the admin console later
# (docs/phase-6.6.md).
VIGILAI_UI_THEME=default
USER_UI_PORT=3000
ADMIN_UI_PORT=3001
