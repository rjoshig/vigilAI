[flake8]
max-line-length = 100
extend-ignore =
    # Whitespace before ':' — black handles this
    E203,
    # Line break before binary operator — black handles this
    W503
# FastAPI's dependency injection is expressed as a call in an argument default, which
# is exactly what B008 warns about. These four are declarations, not work done at
# import time, so bugbear is told to treat them as immutable.
extend-immutable-calls =
    fastapi.Depends,
    fastapi.Query,
    fastapi.File,
    fastapi.Form,
    Depends,
    Query,
    File,
    Form
exclude =
    .git,
    __pycache__,
    .venv,
    venv,
    build,
    dist,
    *.egg-info,
    node_modules,
    user-ui,
    admin-ui,
    mock
per-file-ignores =
    # __init__.py files can have unused imports for re-exports
    __init__.py:F401
