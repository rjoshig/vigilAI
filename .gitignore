# Python
__pycache__/
*.py[cod]
*.egg
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# Node / Next.js (user-ui, admin-ui)
node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
.eslintcache
coverage/
test-results/
playwright-report/

# Secrets — never committed (see standards/git.md, docs/llm-privacy.md)
.env
.env.*
!.env.example
*.pem
*.key

# Runtime data — the shared volume, uploads, reports, DB dumps, logs
data/
*.log
*.db
*.db-wal
*.db-shm

# Real customer files never enter the repo. Fixtures are synthetic only.
tests/fixtures/real/
*.docx
*.xlsx
# A record layout or an attribute dictionary arrives as a spreadsheet, and a
# CSV export of one is derived from a real customer file (ADR-003).
*.csv
!tests/fixtures/**/*.docx
!tests/fixtures/**/*.xlsx
!tests/fixtures/**/*.csv

# IDE / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local database and data volume (ADR-017: SQLite is the default backend)
/data/
*.db
*.db-wal
*.db-shm

# Browser tests (e2e/): the throwaway stack and Playwright's own output
/.e2e-data/
/e2e/test-results/
/e2e/playwright-report/
/e2e/blob-report/
